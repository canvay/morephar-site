# ===== Strapi 后端密钥（务必改成随机值，可用: openssl rand -base64 32）=====
APP_KEYS="changeMe1,changeMe2"
API_TOKEN_SALT=changeMeSalt
ADMIN_JWT_SECRET=changeMeAdminJwt
JWT_SECRET=changeMeJwt
TRANSFER_TOKEN_SALT=changeMeTransfer

# Strapi 管理后台对外访问地址（填你的域名，含 https://）
STRAPI_URL=https://api.example.com

# ===== 前端（Next.js）构建期环境变量 =====
# 注意: NEXT_PUBLIC_* 在构建时写死，改了必须重新 docker compose build
NEXT_PUBLIC_STRAPI_API_URL=https://api.example.com
NEXT_PUBLIC_STRAPI_API_TOKEN=your_readonly_api_token
NEXT_PUBLIC_STRAPI_FORM_SUBMISSION_TOKEN=your_form_submission_token
NEXT_PUBLIC_PAGE_LIMIT=6
