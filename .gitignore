node_modules
readme-images
.vscode
.DS_Store
**/.yarn
.workbuddy
# 种子数据导出文件（体积大，默认不入库）
seed-data*.tar.gz
# 例外：backend/seed-data.tar.gz 为有意入库的部署种子（首次启动由 entrypoint 自动导入），
#       按部署需要入库，正常 git add 即可跟踪。
!backend/seed-data.tar.gz

# 本地/运行时环境变量（含密钥，绝不入库）
.env
# 例外：backend/.env.prod 与 frontend/.env.prod 为有意入库的部署配置（含运行时密钥），
#       按用户要求忽略安全限制，直接入库。
!.env.prod
runner/.credentials
